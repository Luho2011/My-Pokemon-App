
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Run {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())

  pokemon   Pokemon[]
  routes Route[]
}

model Pokemon {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())

  name        String
  img         String
  instanceId  String   @unique

  runId       String
  run         Run      @relation(fields: [runId], references: [id])

  slot        String   // player1 | player2 | player3 | player4 | death
  position    Int?     // Link-Zeile in player1..4, null bei bench/death
}

model Route {
  id        String   @id @default(cuid())
  name      String

  runId String
  run   Run @relation(fields: [runId], references: [id])

  createdAt DateTime @default(now())
}

enum Status {
  ALIVE
  DEAD
}
